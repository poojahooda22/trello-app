{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n routes,server -c magenta,cyan \"bun run generate-routes.ts --watch\" \"bun --hot src/index.ts\"",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run generate-routes.ts && bun run build.ts",
    "routes:generate": "bun run generate-routes.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.167.5",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.32",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.1.11"
  },
  "overrides": {
    "@tanstack/router-core": "1.167.5"
  }
}
