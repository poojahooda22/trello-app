{
  "name": "trello-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:db:up": "docker compose -f docker-compose.test.yml up -d --wait && bun run e2e:db:migrate",
    "e2e:db:migrate": "cd packages/db && DATABASE_URL=postgresql://trello:trello@localhost:5433/trello_test prisma migrate deploy",
    "e2e:db:down": "docker compose -f docker-compose.test.yml down -v",
    "e2e:db:reset": "bun run e2e:db:down && bun run e2e:db:up"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.7.4",
    "turbo": "^2.10.10",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
