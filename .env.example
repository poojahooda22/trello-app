# Copy to .env on the server and fill in. Compose reads this file for the
# ${...} references in docker-compose.yml. It is gitignored; the real one never
# leaves the EC2 box.

# What Caddy answers on. ":80" is plain HTTP on the instance IP; a bare domain
# (trello.example.com) switches it to HTTPS with an automatic certificate.
SITE_ADDRESS=:80

# Where the browser reaches the app. With a domain these become
# https://trello.example.com and wss://trello.example.com.
PUBLIC_ORIGIN=http://184.192.44.63
PUBLIC_WS_ORIGIN=ws://184.192.44.63


# Optional: pin a specific image instead of whatever :latest points at.
# IMAGE_TAG=latest

DATABASE_URL=postgresql://user:password@host.neon.tech/db?sslmode=require
JWT_SECRET=
# 64 hex characters: openssl rand -hex 32
INTEGRATION_KEY=
# Any long random string, shared by the backend and the relay.
WS_INTERNAL_TOKEN=

# GitHub App. Leave blank to run without the integration.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# One line, with the newlines written as literal \n exactly as GitHub hands it over.
GITHUB_PRIVATE_KEY=

# Invite emails. Blank disables sending.
RESEND_API_KEY=
INVITE_FROM=
